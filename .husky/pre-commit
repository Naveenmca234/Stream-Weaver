#!/bin/bash
# Pre-commit hook for StreamWeaver
# Prevents commits with linting errors

echo "Running pre-commit hooks..."

# Colors for output
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

ERRORS=0

# Check backend linting
echo "Checking backend code quality..."
if ! npm run lint --workspace=@streamweaver/backend 2>/dev/null; then
    echo -e "${YELLOW}⚠️  Backend linting found issues${NC}"
    echo "Run: npm run lint:fix --workspace=@streamweaver/backend"
    ERRORS=$((ERRORS + 1))
fi

# Check TypeScript compilation
echo "Checking TypeScript compilation..."
if ! npm run tsc --workspace=@streamweaver/backend 2>/dev/null; then
    echo -e "${RED}✗ TypeScript compilation failed${NC}"
    ERRORS=$((ERRORS + 1))
fi

# Check formatting
echo "Checking code format..."
if ! npm run format:check --workspace=@streamweaver/backend 2>/dev/null; then
    echo -e "${YELLOW}⚠️  Code formatting issues found${NC}"
    echo "Run: npm run format --workspace=@streamweaver/backend"
    ERRORS=$((ERRORS + 1))
fi

if [ $ERRORS -eq 0 ]; then
    echo -e "${GREEN}✓ All pre-commit checks passed${NC}"
    exit 0
else
    echo -e "${RED}✗ Pre-commit checks failed. Fix issues before committing.${NC}"
    exit 1
fi
