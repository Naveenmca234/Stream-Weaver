{
  "name": "streamweaver",
  "version": "1.0.0",
  "private": true,
  "description": "Visual ETL. Massive Scale. Zero-Code Complexity.",
  "workspaces": [
    "backend_backup",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@streamweaver/backend\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=@streamweaver/backend && npm run build --workspace=client",
    "benchmark": "npm run benchmark --workspace=@streamweaver/backend",
    "lint": "npm run lint --workspace=@streamweaver/backend && npm run lint --workspace=client",
    "lint:fix": "npm run lint:fix --workspace=@streamweaver/backend && npm run lint --workspace=client -- --fix",
    "format": "npm run format --workspace=@streamweaver/backend",
    "format:check": "npm run format:check --workspace=@streamweaver/backend",
    "test": "npm test --workspace=@streamweaver/backend",
    "tsc": "npm run tsc --workspace=@streamweaver/backend",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "npm install && npm run build",
    "prepare": "husky install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.0.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0"
  }
}
